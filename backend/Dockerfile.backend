FROM python:3.12

# Install necessary OS-level dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    flac \
    git \
    pkg-config \
    curl \
    build-essential \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libavdevice-dev \
    libavfilter-dev \
    libsdl2-dev \
    libva-dev \
    libsndfile1-dev \
    python3-dev \
    cmake \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Rust with retry
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y || \
    curl https://sh.rustup.rs -sSf | sh -s -- -y

ENV PATH="/root/.cargo/bin:${PATH}"

# Add retry logic for git clone
RUN set -x && \
    for i in $(seq 1 5); do \
    git clone https://github.com/google/sentencepiece.git && s=0 && break || s=$? && echo "Retrying ($i/5) ..." && sleep 15; \
    done; (exit $s)

WORKDIR sentencepiece
RUN mkdir build
WORKDIR build
RUN cmake .. && make -j $(nproc) && make install && ldconfig

# Set the working directory
WORKDIR /app

# Set Pip timeout and retries
ENV PIP_DEFAULT_TIMEOUT=200

# Install pip, setuptools, and wheel
RUN python -m pip install --upgrade pip setuptools wheel

# Upgrade certifi separately
RUN pip install --upgrade certifi

# Install a compatible version of Cython
RUN pip install cython==0.29.36

# Copy requirements file
COPY requirements.txt .

# Install primary dependencies with retries
RUN pip install --no-cache-dir --retries 10 -r requirements.txt

# Install the openai-whisper package
RUN pip install -U openai-whisper

# Install setuptools-rust to handle Rust extensions in Python
RUN pip install setuptools-rust

# Install the transformers and huggingface libraries and verify SentencePiece
RUN pip install transformers huggingface-hub sentencepiece && \
    python -c "import sentencepiece as spm"

# Copy the model download script and run it
COPY download_models.py ./
RUN python download_models.py

# Copy the rest of the application source code
COPY . .

# Modify flask/app.py directly for compatibility issue (last resort if needed)
RUN sed -i 's/url_quote/unquote/g' /usr/local/lib/python3.12/site-packages/flask/app.py

# Expose the port the app runs on
EXPOSE 5500

# Command to run the application using gunicorn on port 5500
CMD ["gunicorn", "--bind", "0.0.0.0:5500", "app:app"]